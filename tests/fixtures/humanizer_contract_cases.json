{
  "cases": [
    {
      "id": "dense_ai_rewrite",
      "mode": "rewrite",
      "tags": [
        "rewrite_only_output",
        "factual_integrity",
        "no_em_dash",
        "no_chatbot_wrapper",
        "no_contrast_frame",
        "no_rule_of_three",
        "no_self_narration",
        "preserve_supplied_facts"
      ],
      "prompt": "Humanize this text. Return only the rewritten text.",
      "source": "Great question! Here is an overview. AI coding assistants serve as an enduring testament to the transformative potential of large language models, marking a pivotal moment in the rapidly evolving landscape of software development. At its core, the value proposition is clear: streamlining documentation, enhancing tests, and fostering alignment. It is not just about autocomplete; it is about unlocking creativity at scale. Industry observers have noted adoption is rising. Let me know if you want more detail.",
      "constraints": {
        "must_include": [
          "AI coding assistants",
          "doc",
          "test"
        ],
        "must_not_include": [
          "Great question",
          "Here is",
          "enduring testament",
          "transformative potential",
          "pivotal moment",
          "rapidly evolving landscape",
          "At its core",
          "streamlining",
          "enhancing",
          "fostering",
          "alignment",
          "aligned",
          "not just",
          "unlocking creativity",
          "Industry observers",
          "Let me know",
          "grind",
          "routine code",
          "rough edges",
          "by hand",
          "the actual problem",
          "bigger value",
          "move faster",
          "save developers time",
          "reducing the drag",
          "take some of the drag",
          "spend more time",
          "work that needs judgment",
          "one of the clearest ways",
          "showing up in software development",
          "practical value",
          "stay on the same page",
          "more visible ways",
          "clearest uses",
          "part of the story",
          "part of the picture",
          "broader question",
          "day-to-day coding",
          "claims about alignment",
          "broader claims about creativity",
          "most concrete uses"
        ],
        "must_not_match": [
          "(?i)future looks bright",
          "(?i)game[- ]changer",
          "(?i)\\bdoc(?:s|umentation)?\\b,\\s+tests?,\\s+and\\s+[^.?!,;:]+",
          "(?i)\\b(?:make|makes|making)\\b[^.?!]{0,60}\\beasier\\b",
          "(?i)\\bwithout\\s+(?:lowering|reducing)\\s+(?:the\\s+)?quality\\b",
          "(?i)\\b(?:the\\s+)?pace\\s+depends\\s+on\\b",
          "(?i)\\bmore\\s+than\\s+(?:just\\s+)?autocomplete\\b",
          "(?i)(?:^|[.!?]\\s+)adoption\\s+is\\s+(?:rising|growing)(?:[.!?]|$)"
        ],
        "no_em_dash": true,
        "no_chatbot_wrapper": true,
        "no_contrast_frame": true,
        "no_rule_of_three": true,
        "no_markdown_fence": true,
        "no_new_numbers": true,
        "no_new_named_entities": true,
        "rewrite_only": true
      }
    },
    {
